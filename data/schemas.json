{
  "$comment": "데이터별 표의 레코드 형식. tools/build.mjs가 이 형식으로 검사하고 openapi.json에도 그대로 싣는다. src는 sources.json의 출처 id 목록이다",
  "link-bonus": {
    "values": {
      "type": "object",
      "required": ["star", "star_label", "level", "value", "heal_value", "src"],
      "additionalProperties": false,
      "properties": {
        "star": { "type": "integer", "minimum": 0, "maximum": 10, "description": "대상 무기의 ★ 수. 0은 ★ 없음" },
        "star_label": { "type": "string", "description": "게임 표기(★ 없음, ★1 …)" },
        "level": { "type": "integer", "minimum": 1, "maximum": 20, "description": "각인 강화 단계" },
        "value": { "type": "integer", "minimum": 0, "description": "각인 룬 값(추가 공격력에 더해지는 값)" },
        "heal_value": { "type": "integer", "minimum": 0, "description": "아군 회복에 적용될 때 일반 값 대신 쓰이는 값" },
        "src": { "$ref": "#/src" }
      }
    }
  },
  "weekly": {
    "items": {
      "type": "object",
      "required": ["id", "group", "name", "counts", "description", "src"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+$", "description": "항목 식별자(바뀌지 않음)" },
        "group": { "type": "string", "enum": ["전투", "미션", "성장·생활"] },
        "name": { "type": "string" },
        "counts": {
          "type": "array", "minItems": 1, "description": "세부 항목별 주간 최대 횟수. 세부가 없으면 name이 빈 문자열",
          "items": { "type": "object", "required": ["name", "max"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "max": { "type": "integer", "minimum": 1 } } }
        },
        "description": { "type": "string" },
        "src": { "$ref": "#/src" }
      }
    }
  },
  "soulstream": {
    "production": {
      "type": "object",
      "required": ["soul", "stat", "sum_from", "sum_to", "rate_min", "rate_max", "src"],
      "additionalProperties": false,
      "properties": {
        "soul": { "type": "string", "enum": ["붉은", "푸른", "노란"] },
        "stat": { "type": "string", "description": "생산량을 정하는 서버 내 캐릭터 능력치 합의 종류" },
        "sum_from": { "type": "integer", "minimum": 0, "description": "능력치 합 구간 시작" },
        "sum_to": { "type": "integer", "minimum": 1, "description": "능력치 합 구간 끝" },
        "rate_min": { "type": "number", "minimum": 0, "description": "이 구간의 시간당 최소 생산량" },
        "rate_max": { "type": "number", "minimum": 0, "description": "이 구간의 시간당 최대 생산량" },
        "src": { "$ref": "#/src" }
      }
    },
    "purchase": {
      "type": "object",
      "required": ["count_from", "count_to", "start_price", "step", "src"],
      "additionalProperties": false,
      "properties": {
        "count_from": { "type": "integer", "minimum": 1, "description": "누적 구매 회차 시작(소울별)" },
        "count_to": { "type": "integer", "minimum": 1, "description": "누적 구매 회차 끝" },
        "start_price": { "type": "integer", "minimum": 0, "description": "구간 첫 회차 가격(골드)" },
        "step": { "type": "integer", "minimum": 0, "description": "회차마다 오르는 골드" },
        "src": { "$ref": "#/src" }
      }
    }
  },
  "leveling-materials": {
    "steps": {
      "type": "object",
      "required": ["level", "materials", "src"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 100, "description": "퀘스트를 만나는 캐릭터 레벨" },
        "materials": { "$ref": "#/materials" },
        "src": { "$ref": "#/src" }
      }
    },
    "recipes": {
      "type": "object",
      "required": ["item", "materials", "src"],
      "additionalProperties": false,
      "properties": {
        "item": { "type": "string", "description": "직접 만들어야 하는 요리" },
        "materials": { "$ref": "#/materials" },
        "src": { "$ref": "#/src" }
      }
    }
  },
  "summon-barrier": {
    "schedule": {
      "type": "object",
      "required": ["every", "appear_minute", "start_minute", "src"],
      "additionalProperties": false,
      "properties": {
        "every": { "type": "string", "enum": ["hour"] },
        "appear_minute": { "type": "integer", "minimum": 0, "maximum": 59, "description": "나타나는 분(한국 시간)" },
        "start_minute": { "type": "integer", "minimum": 0, "maximum": 59, "description": "시작하는 분(한국 시간)" },
        "src": { "$ref": "#/src" }
      }
    }
  },
  "mado-resist": {
    "examples": {
      "type": "object",
      "required": ["over", "final_damage_pct", "src"],
      "additionalProperties": false,
      "properties": {
        "over": { "type": "integer", "minimum": 0, "description": "마도 저항이 압력을 넘은 수치" },
        "final_damage_pct": { "type": "number", "minimum": 0, "maximum": 100, "description": "늘어나는 최종 피해(%)" },
        "src": { "$ref": "#/src" }
      }
    }
  },
  "rune-engraving-rate": {
    "rates": {
      "type": "object",
      "required": ["grade", "stars", "rate_pct", "src"],
      "additionalProperties": false,
      "properties": {
        "grade": { "type": "string", "enum": ["고급", "레어", "엘리트", "에픽", "전설", "신화"] },
        "stars": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 10 } },
        "rate_pct": { "type": "number", "minimum": 0, "maximum": 100, "description": "각인 성공률(%). 실패하면 장비가 저주받음" },
        "src": { "$ref": "#/src" }
      }
    }
  },
  "#": {
    "src": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "description": "출처 id 목록(sources.json)" },
    "materials": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["name", "qty"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "qty": { "type": "integer", "minimum": 1 } } }
    }
  }
}
